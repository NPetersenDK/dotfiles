{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "kubectl",
          "style": "plain",
          "background": "#E5C07B",
          "foreground": "#193549",
          "template": " k8s:{{ .Context }}{{ if .Namespace }}/{{ .Namespace }}{{ end }} ",
          "options": {
            "parse_kubeconfig": true
          }
        },
        {
          "type": "az",
          "style": "plain",
          "background": "#56B6C2",
          "foreground": "#193549",
          "template": " az:{{ .Name }} "
        },
        {
          "type": "dotnet",
          "style": "plain",
          "background": "#7B61FF",
          "foreground": "#ffffff",
          "template": " dotnet:{{ .Full }} "
        },
        {
          "type": "executiontime",
          "style": "plain",
          "background": "#3E4451",
          "foreground": "#ffffff",
          "template": " time:{{ .FormattedMs }} ",
          "options": {
            "threshold": 2000,
            "style": "austin"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "session",
          "style": "plain",
          "background": "#61AFEF",
          "foreground": "#ffffff",
          "template": " {{ .UserName }}@{{ .HostName }} "
        },
        {
          "type": "path",
          "style": "plain",
          "background": "#C678DD",
          "foreground": "#ffffff",
          "template": " {{ .Path }} ",
          "options": {
            "style": "agnoster_short",
            "folder_separator_icon": "/",
            "max_depth": 3
          }
        },
        {
          "type": "git",
          "style": "plain",
          "background": "#95ffa4",
          "background_templates": [
            "{{ if gt .Behind 0 }}#FF6471{{ end }}",
            "{{ if or .Working.Changed .Staging.Changed }}#FFD866{{ end }}"
          ],
          "foreground": "#193549",
          "template": " git:{{ .HEAD }}{{ if gt .Ahead 0 }} >{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }} <{{ .Behind }}{{ end }}{{ if and .Upstream (not .UpstreamGone) (eq .Ahead 0) (eq .Behind 0) }} ={{ end }}{{ if .Staging.Changed }} [S {{ .Staging.String }}]{{ end }}{{ if .Working.Changed }} [W {{ .Working.String }}]{{ end }}{{ if gt .StashCount 0 }} ${{ .StashCount }}{{ end }} ",
          "options": {
            "branch_icon": "",
            "commit_icon": "commit:",
            "tag_icon": "tag:",
            "rebase_icon": "rebase:",
            "cherry_pick_icon": "cherry-pick:",
            "revert_icon": "revert:",
            "merge_icon": "merge:",
            "no_commits_icon": "new:",
            "branch_max_length": 40,
            "fetch_status": true
          }
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#95ffa4",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#FF6471{{ end }}"
          ],
          "template": " >"
        }
      ]
    }
  ]
}
